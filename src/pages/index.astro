---
import { getImage } from 'astro:assets';
import Header from "../components/Header";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TripAwards from "../components/TripAwards.astro";
import OurServices from "../components/OurServices.astro";
import ServiceRegion from "../components/ServiceRegion.astro";
import Footer from "../components/Footer.astro";
import Destinations from "../components/Destinations.astro";
import Reviews from "../components/Reviews";
import FAQ from "../components/FAQ";
import OurServicesDetails from "../components/OurServicesDetails.astro";
import maianaAvatar from "../assets/maiana-avatar.jpg";
import faqImage from "../assets/faqimage.png";

const optimizedMaianaAvatar = await getImage({ src: maianaAvatar });
const optimizedFaqImage = await getImage({ src: faqImage });
---

<Layout>
  <Header client:load />
  <Hero />
  <TripAwards />
  <OurServices />
  <ServiceRegion />
  <Destinations />
  <OurServicesDetails />
  <Reviews maianaAvatar={optimizedMaianaAvatar} client:load />
  <FAQ faqImage={optimizedFaqImage} client:load />
  <Footer />
</Layout>