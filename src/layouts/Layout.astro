---
import "../styles/global.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/vite.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Transfer Club Med Trancoso, Trancoso, Caraíva, Porto Seguro | GPS Transfer
    </title>
    <GoogleTagmanager id="GTM-5ZL5QX3" />
    <meta
      name="og:description"
      content="Transfer Club Med Trancoso, Trancoso, Caraíva, Porto Seguro. A GPS Transfer é uma empresa especializada em transfer de aeroporto para hotéis e pousadas em Trancoso, Caraíva, Porto Seguro e região."
    />
    <meta
      name="keywords"
      content="Transfer Club Med Trancoso, Trancoso, Caraíva, Porto Seguro, GPS Transfer"
    />
    <meta name="author" content="Vinícius de Alencar Freire" />
    <meta property="og:image" content="https://i.imgur.com/VyyElng.png" />
    <meta property="og:url" content="https://gpstransfer.com.br" />
    <meta property="og:url" content="https://gpstransfer.com.br" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <GoogleTagmanagerNoscript id="GTM-5ZL5QX3" />
    <slot />
  </body>
</html>
