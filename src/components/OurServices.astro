---
import { Image } from 'astro:assets';
import OurServicesImage from '../assets/ourservices.jpg';
import ButtonCTA from './ui/ButtonCTA';
---

<div class="mx-auto max-w-[1440px] px-[100px] max-md:px-[20px]">
  <section class="flex justify-between items-center gap-20 py-30 max-md:py-10 max-md:flex-wrap max-md:px-0 max-md:gap-10 max-md:justify-center">
    <div class="flex flex-col gap-6 max-md:text-center max-w-[724px] max-md:items-center">
      <h2 class="text-title-2 leading-[120%] font-bold max-md:text-mobile-title-2">
        Nossos serviços
      </h2>
      <p class="text-subtitle-2 font-medium text-gray-dark max-md:text-mobile-subtitle-1">
        Oferecemos traslados privativos com conforto, segurança e
        pontualidade na região de Porto Seguro. Atendemos desde viajantes
        individuais até grupos pequenos e grandes. Seja translados entre
        aeroporto, hotéis ou destinos turísticos, nosso compromisso é
        proporcionar praticidade e excelência em cada trajeto.
      </p>
      <ButtonCTA
        text="Fazer Orçamento"
        href="https://api.whatsapp.com/send?phone=5573998344769&text=Ol%C3%A1%2C%20vim%20pelo%20site%2C%20gostaria%20de%20saber%20mais%20sobre%20o%20transfer..."
      />
    </div>
    <div class="max-w-[500px]">
      <Image
        src={OurServicesImage}
        alt="Nossos serviços de transfer"
        class="rounded-2xl w-full"
      />
    </div>
  </section>
</div>