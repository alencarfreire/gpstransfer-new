---
import { Image } from 'astro:assets';
import privativoCasal from '../assets/privativo-casal.png';
import familiaGruposPequenos from '../assets/familias-grupos-pequenos.png';
import grupoMediosGrandes from '../assets/grupo-medios-grandes.png';
import servicoCasamento from '../assets/transfer-casamento.png';
import ButtonCTA from './ui/ButtonCTA';
---

<section
  class="mx-auto max-w-[1440px] px-[100px] max-md:px-[20px] my-30 flex flex-col gap-12"
  id="servicos"
>
  <h1 class="text-title-2 max-md:text-mobile-title-1 max-lg:text-center font-bold max-lg:max-w-[400px] max-xl:mx-auto">
    Simplifique sua viagem com os nossos serviços
  </h1>
  <div class="flex justify-between items-center gap-10 max-lg:flex-wrap max-lg:justify-center max-lg:gap-5">
    <div class="w-[500px] lg:w-[500px]">
      <Image
        src={privativoCasal}
        alt="Privativo individual ou casal"
        class="rounded-2xl w-full h-[350px] object-cover"
      />
    </div>
    <div>
      <h4 class="text-title-3 max-lg:text-mobile-title-2 font-bold max-lg:text-center">
        Privativo individual ou casal
      </h4>
      <p class="text-subtitle-2 max-lg:text-mobile-subtitle-2 max-lg:text-center max-lg:max-w-[350px] mb-5">
        Traslados rápidos e confortáveis entre aeroporto, hotéis e resorts
        de Porto Seguro.
      </p>
      <div class="lg:hidden">
        <ButtonCTA
          text="Agendar Privativo"
          href="https://api.whatsapp.com/send?phone=5573998344769&text=Ol%C3%A1%2C%20vim%20pelo%20site%2C%20gostaria%20de%20agendar%20um%20transfer%20privativo..."
        />
      </div>
    </div>
  </div>
  <div class="flex justify-between lg:flex-row-reverse items-center gap-10 max-lg:flex-wrap max-lg:justify-center max-lg:gap-5">
    <div class="w-[500px] lg:w-[500px]">
      <Image
        src={familiaGruposPequenos}
        alt="Famílias e grupos pequenos"
        class="rounded-2xl w-full h-[350px] object-cover"
      />
    </div>
    <div>
      <h4 class="text-title-3 max-lg:text-mobile-title-2 font-bold max-lg:text-center">
        Famílias e grupos pequenos
      </h4>
      <p class="text-subtitle-2 max-lg:text-mobile-subtitle-2 max-lg:text-center max-lg:max-w-[350px] mb-5">
        Veículos espaçosos para até 6 pessoas, com segurança e comodidade.
      </p>
      <div class="lg:hidden">
        <ButtonCTA
          text="Agendar Privativo"
          href="https://api.whatsapp.com/send?phone=5573998344769&text=Ol%C3%A1%2C%20vim%20pelo%20site%2C%20gostaria%20de%20agendar%20um%20transfer%20privativo..."
        />
      </div>
    </div>
  </div>
  <div class="flex justify-between items-center gap-10 max-lg:flex-wrap max-lg:justify-center max-lg:gap-5">
    <div class="w-[500px] lg:w-[500px]">
      <Image
        src={grupoMediosGrandes}
        alt="Grupos médios e grandes"
        class="rounded-2xl w-full h-[350px] object-cover"
      />
    </div>
    <div>
      <h4 class="text-title-3 max-lg:text-mobile-title-2 font-bold max-lg:text-center">
        Grupos médios e grandes
      </h4>
      <p class="text-subtitle-2 max-lg:text-mobile-subtitle-2 max-lg:text-center max-lg:max-w-[350px] mb-5">
        Vans para grupos grandes e eventos corporativos.
      </p>
      <div class="lg:hidden">
        <ButtonCTA
          text="Agendar Privativo"
          href="https://api.whatsapp.com/send?phone=5573998344769&text=Ol%C3%A1%2C%20vim%20pelo%20site%2C%20gostaria%20de%20agendar%20um%20transfer%20privativo..."
        />
      </div>
    </div>
  </div>
  <div class="flex justify-between lg:flex-row-reverse items-center gap-10 max-lg:flex-wrap max-lg:justify-center max-lg:gap-5">
    <div class="w-[500px] lg:w-[500px]">
      <Image
        src={servicoCasamento}
        alt="Casamentos e eventos fechados"
        class="rounded-2xl w-full h-[350px] object-cover"
      />
    </div>
    <div>
      <h4 class="text-title-3 max-lg:text-mobile-title-2 font-bold max-lg:text-center">
        Casamentos e eventos fechados
      </h4>
      <p class="text-subtitle-2 max-lg:text-mobile-subtitle-2 max-lg:text-center max-lg:max-w-[350px] mb-5">
        Transfer para casamentos e cobertura de transfer para casamentos e
        cerimônias especiais.
      </p>
      <div class="lg:hidden">
        <ButtonCTA
          text="Agendar Privativo"
          href="https://api.whatsapp.com/send?phone=5573998344769&text=Ol%C3%A1%2C%20vim%20pelo%20site%2C%20gostaria%20de%20agendar%20um%20transfer%20privativo..."
        />
      </div>
    </div>
  </div>
</section>