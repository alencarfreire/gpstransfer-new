---
import { Image } from 'astro:assets';
import imageHero from '../assets/image-hero.webp';
import ButtonCTA from './ui/ButtonCTA';
---

<div class="mx-auto max-w-[1440px] px-[100px] max-md:px-[20px]">
  <section class="mt-20 mb-10 max-sm:mt-8">
    <div class="flex justify-between gap-10 max-md:gap-2 items-start max-md:flex-col">
      <h1 class="text-7xl leading-20 font-bold text-balance max-lg:text-5xl max-lg:leading-12 max-lg:font-black max-lg:text-center">
        Seu transfer privativo no aeroporto de Porto Seguro
      </h1>
      <div class="mt-5 flex flex-col items-start gap-6 max-md:items-center">
        <p class="text-2xl max-md:text-mobile-subtitle-1 max-md:text-center text-gray-dark">
          Evite surpresas, faça sua reserva e o seu transfer privativo
          estará pronto no desembarque.
        </p>
        <ButtonCTA
          text="Agendar Privativo"
          href="https://api.whatsapp.com/send?phone=5573998344769&text=Ol%C3%A1%2C%20vim%20pelo%20site%2C%20gostaria%20de%20agendar%20um%20transfer%20privativo..."
        />
      </div>
    </div>
    <div class="mt-10 max-md:mx-4">
      <Image
        src={imageHero}
        alt="Seu transfer privativo no aeroporto de Porto Seguro"
        loading="eager"
        class="w-full max-h-[540px] rounded-3xl object-cover max-md:h-[280px] max-md:rounded-3xl object-[25%_60%]"
      />
    </div>
  </section>
</div>