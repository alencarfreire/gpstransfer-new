---
import { Image } from 'astro:assets';
import TripAdvisor from '../assets/tripadvisor2026.webp';
---

<div class="mx-auto max-w-[1440px] px-[100px] max-md:px-[20px]">
  <section class="flex justify-between items-center gap-20 p-10 max-md:flex-wrap max-md:px-0 max-md:gap-10 max-md:justify-center">
    <div class="flex flex-col gap-6 max-md:text-center">
      <h2 class="text-title-2 leading-[120%] font-bold max-md:text-mobile-title-2">
        Travelers' Choice Awards
      </h2>
      <p class="text-subtitle-2 font-medium text-gray-dark max-md:text-mobile-subtitle-1">
        A GPS Transfer foi reconhecida com o prêmio Travelers' Choice do
        TripAdvisor. Esse prêmio destaca as empresas que recebem
        consistentemente ótimas avaliações dos viajantes, colocando-as entre
        as 10% melhores do mundo.
      </p>
    </div>
    <Image
      src={TripAdvisor}
      alt="TripAdvisor Travelers' Choice Awards 2026"
      class="max-w-54"
    />
  </section>
</div>